#!/usr/bin/env bash
# Builds the cleanroom against the published UPM package (io.teak.unity.sdk#<major>.<minor>).
# Bootstraps gems, then runs `rake verify:upm`. Env (UNITY_HOME, TARGET_API, ...) passes through.
set -euo pipefail
cd "$(dirname "$0")/.."

bundle check >/dev/null 2>&1 || bundle install

USE_FACEBOOK="${USE_FACEBOOK:-false}" bundle exec rake verify:upm

pkg=$(ls -d Library/PackageCache/io.teak.unity.sdk* 2>/dev/null | head -n1 || true)
if [[ -n "$pkg" ]]; then
  version=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$pkg/package.json" | head -n1)
  echo "verify-upm: built against io.teak.unity.sdk ${version:-unknown} ($pkg)"
else
  echo "verify-upm: io.teak.unity.sdk not found in Library/PackageCache" >&2
  exit 1
fi
