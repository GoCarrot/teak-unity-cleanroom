#!/usr/bin/env ruby
# frozen_string_literal: true

# Taps Teak universal links in Safari on an iOS device, cold and warm, and reports which path
# delivered each one. Reads the links from safari-links/index.html, serves that page from this Mac
# (it has to be on a different host than the links, or iOS opens them in Safari), and checks the
# app's log for, per tap:
#
#   a. a "link delivery" line (Assets/Plugins/iOS/LinkDeliveryLog.m) with an NSUserActivity for the URL
#   b. a users.json request whose launch_link is the URL
#   c. OnPostLaunchSummary, whose DeepLink ends with the link's data-deeplink when it has one
#   d. deep_link.request.send for the URL (only the universal-link resolve sends it)
#
#   script/safari-links --app path/to/App.app --device <udid>
#
# The app must be a build of this project. The run installs it fresh (iOS caches the AASA per
# install) and leaves a marker so the TestDriver suite doesn't start. The Mac and the device have to
# be on the same network. Cold: the app is killed, then Safari opens the page and the tap launches
# it. Warm: the app is running, Safari opens over it, the tap brings it back.
#
# Exit status: 0 every tap passed, 1 a tap failed, 2 the run couldn't be set up.

require 'fileutils'
require 'json'
require 'open3'
require 'optparse'
require 'shellwords'
require 'socket'
require 'tmpdir'

ROOT = File.expand_path('..', __dir__)
PAGE_DIR = File.join(ROOT, 'safari-links')
DRIVER_PROJECT = File.join(ROOT, 'ios-driver', 'CleanroomDriver.xcodeproj')
LINK_MODE_MARKER = 'safari-link-mode'
SAFARI = 'com.apple.mobilesafari'

options = { port: 8404, settle: 10, wait: 60 }
OptionParser.new do |o|
  o.banner = 'Usage: script/safari-links --app App.app --device UDID [options]'
  o.on('--app PATH', 'Built .app to install') { |v| options[:app] = File.expand_path(v) }
  o.on('--device UDID', 'Physical device (explicit UDID, never a default)') { |v| options[:device] = v }
  o.on('--port PORT', Integer, "Page server port (default #{options[:port]})") { |v| options[:port] = v }
  o.on('--host HOST', 'Address the device reaches this Mac at (default: its LAN address)') { |v| options[:host] = v }
  o.on('--only LABEL', 'Run just the link with this text') { |v| options[:only] = v }
  o.on('--settle SECONDS', Integer, "Warm: wait this long after the app starts (default #{options[:settle]})") { |v| options[:settle] = v }
  o.on('--wait SECONDS', Integer, "Wait this long for a tap's log lines (default #{options[:wait]})") { |v| options[:wait] = v }
  o.on('--out DIR', 'Where logs go (default build/safari-links/<time>)') { |v| options[:out] = File.expand_path(v) }
  o.on('--skip-driver-build', 'Use the driver already built under build/DriverDerivedData') { options[:skip_driver_build] = true }
  o.on('--allow-provisioning-updates', 'Let Xcode register the device and create profiles on the shared Apple team') do
    options[:allow_provisioning_updates] = true
  end
end.parse!

abort 'missing --app' unless options[:app] && File.directory?(options[:app])
abort 'missing --device (UDID from xcrun xctrace list devices)' unless options[:device]

Link = Struct.new(:label, :url, :deeplink, keyword_init: true)

def say(message)
  puts "[safari-links] #{message}"
  $stdout.flush
end

def run(*cmd, env: {})
  Open3.capture2e(env, *cmd)
end

def run!(*cmd, env: {})
  out, status = run(*cmd, env: env)
  abort "#{cmd.shelljoin} failed:\n#{out}" unless status.success?
  out
end

def plist_value(app, key)
  out, status = Open3.capture2('plutil', '-extract', key, 'raw', '-o', '-', File.join(app, 'Info.plist'))
  status.success? ? out.strip : nil
end

def page_links(path)
  File.read(path).scan(/<a\s+([^>]*)>(.*?)<\/a>/m).map do |attrs, text|
    Link.new(label: text.strip, url: attrs[/href="([^"]+)"/, 1], deeplink: attrs[/data-deeplink="([^"]+)"/, 1])
  end
end

def lan_host
  Socket.ip_address_list.find { |a| a.ipv4_private? && !a.ipv4_loopback? }&.ip_address
end

# What one tap left in the log.
class Observation
  attr_reader :link, :lines

  def initialize(link, lines)
    @link = link
    @lines = lines
  end

  def delivery
    lines.grep(/link delivery path=/).select { |l| l.include?(link.url) }
  end

  def a = delivery.find { |l| l.include?('type=NSUserActivityTypeBrowsingWeb') }
  def b = lines.find { |l| l.include?("[Test Driver] teak event request.send users.json launch_link=#{link.url}") }
  def d = lines.find { |l| l.include?('[Test Driver] teak event deep_link.request.send') && l.include?(link.url) }

  def c
    summary = lines.find { |l| l.include?('OnPostLaunchSummary:') && l.include?("LaunchLink = '#{link.url}'") }
    return summary unless summary && link.deeplink

    summary[/DeepLink = '([^']*)'/, 1].to_s.end_with?(link.deeplink) ? summary : nil
  end

  def pass? = [a, b, c, d].all?

  def missing
    { 'a delivery' => a, 'b launch_link' => b, 'c summary' => c, 'd resolve' => d }.select { |_, v| v.nil? }.keys
  end

  def done? = pass?
end

# Streams a child's merged output to a log file and a block.
def spawn_streaming(cmd, env, log_path, &on_line)
  stdin, out, wait = Open3.popen2e(env, *cmd, pgroup: true)
  stdin.close
  reader = Thread.new do
    File.open(log_path, 'w') do |log|
      out.each_line do |raw|
        line = raw.scrub.chomp
        log.puts(line)
        log.flush
        on_line&.call(line)
      end
    end
  rescue IOError
    nil
  end
  [wait, reader]
end

def stop(wait)
  return unless wait&.alive?

  Process.kill('INT', -wait.pid)
  return if wait.join(15)

  Process.kill('KILL', -wait.pid)
  wait.join(5)
rescue Errno::ESRCH
  nil
end

app = options[:app]
udid = options[:device]
bundle_id = plist_value(app, 'CFBundleIdentifier') or abort "no CFBundleIdentifier in #{app}"
executable = plist_value(app, 'CFBundleExecutable') or abort "no CFBundleExecutable in #{app}"
links = page_links(File.join(PAGE_DIR, 'index.html'))
links = links.select { |l| l.label == options[:only] } if options[:only]
abort 'no links on the page' if links.empty?
abort "link labels must be unique: #{links.map(&:label).tally.select { |_, n| n > 1 }.keys}" if links.map(&:label).uniq.size != links.size

host = options[:host] || lan_host or abort 'no LAN address found, pass --host'
page_url = "http://#{host}:#{options[:port]}/"
started_at = Time.now
out_dir = options[:out] || File.join(ROOT, 'build', 'safari-links', started_at.strftime('%Y%m%d-%H%M%S'))
FileUtils.mkdir_p(out_dir)
say "device #{udid}, #{bundle_id}, page #{page_url}, out #{out_dir}"

children = []
at_exit { children.each { |child| stop(child) } }
%w[INT TERM].each { |signal| trap(signal) { exit 130 } }

# Page
server_wait, = spawn_streaming(['ruby', '-run', '-e', 'httpd', PAGE_DIR, '-p', options[:port].to_s, '-b', '0.0.0.0'], {},
                               File.join(out_dir, 'server.log'))
children << server_wait
reached = false
20.times do
  reached = system('curl', '-sf', '-o', '/dev/null', page_url)
  break if reached

  sleep 0.5
end
abort "the page isn't reachable at #{page_url}, see #{File.join(out_dir, 'server.log')}" unless reached

# Driver
driver_data = File.join(ROOT, 'build', 'DriverDerivedData')
extra = options[:allow_provisioning_updates] ? %w[-allowProvisioningUpdates -allowProvisioningDeviceRegistration] : []
unless options[:skip_driver_build]
  say 'building driver'
  build_out, build_status = run('xcodebuild', 'build-for-testing', '-project', DRIVER_PROJECT, '-scheme', 'Driver',
                                '-destination', "id=#{udid}", '-derivedDataPath', driver_data, *extra)
  File.write(File.join(out_dir, 'driver-build.log'), build_out)
  abort "driver build failed, see #{File.join(out_dir, 'driver-build.log')}" unless build_status.success?
end
xctestrun = Dir.glob(File.join(driver_data, 'Build', 'Products', '*.xctestrun')).max_by { |f| File.mtime(f) }

# App: fresh install, with the marker that keeps the suite from starting.
say 'installing app'
run('xcrun', 'devicectl', 'device', 'uninstall', 'app', '--device', udid, bundle_id)
run!('xcrun', 'devicectl', 'device', 'install', 'app', '--device', udid, app)
Dir.mktmpdir('safari-links-marker') do |dir|
  marker = File.join(dir, LINK_MODE_MARKER)
  File.write(marker, "1\n")
  run!('xcrun', 'devicectl', 'device', 'copy', 'to', '--device', udid, '--source', marker,
       '--destination', "Documents/#{LINK_MODE_MARKER}", '--domain-type', 'appDataContainer',
       '--domain-identifier', bundle_id)
end

# The app's log. A cold tap launches the app from outside, so there is no console to attach to.
syslog_path = File.join(out_dir, 'syslog.log')
syslog = []
syslog_lock = Mutex.new
syslog_wait, = spawn_streaming(['idevicesyslog', '-u', udid, '-p', executable, '--no-colors'], {}, syslog_path) do |line|
  syslog_lock.synchronize { syslog << line }
end
children << syslog_wait

def kill_app(udid, executable)
  json = File.join(Dir.tmpdir, "safari-links-procs-#{Process.pid}.json")
  run('xcrun', 'devicectl', 'device', 'info', 'processes', '--device', udid, '--json-output', json)
  procs = JSON.parse(File.read(json)).dig('result', 'runningProcesses') || []
  procs.select { |p| p['executable'].to_s.include?("/#{executable}") }.each do |p|
    run('xcrun', 'devicectl', 'device', 'process', 'terminate', '--device', udid, '--pid', p['processIdentifier'].to_s, '--kill')
  end
  sleep 2
ensure
  FileUtils.rm_f(json)
end

def open_page(udid, page_url)
  run!('xcrun', 'devicectl', 'device', 'process', 'launch', '--device', udid, '--terminate-existing',
       '--payload-url', page_url, SAFARI)
  sleep 3
end

def tap(xctestrun, udid, bundle_id, label, log_path, extra)
  env = { 'TEST_RUNNER_CLEANROOM_TAP_LABEL' => label, 'TEST_RUNNER_CLEANROOM_BUNDLE_ID' => bundle_id }
  out, status = run('xcodebuild', 'test-without-building', '-xctestrun', xctestrun, '-destination', "id=#{udid}",
                    '-only-testing:DriverUITests/Driver/testTapLink', *extra, env: env)
  File.write(log_path, out)
  status.success?
end

results = []
links.each do |link|
  %w[cold warm].each do |mode|
    name = "#{link.label} (#{mode})"
    say name
    if mode == 'cold'
      kill_app(udid, executable)
    else
      run!('xcrun', 'devicectl', 'device', 'process', 'launch', '--device', udid, '--terminate-existing', bundle_id)
      deadline = Time.now + 60
      sleep 1 until Time.now > deadline || syslog_lock.synchronize { syslog.any? { |l| l.include?('TestDriver Lifecycle: Start') } }
      sleep options[:settle]
    end
    mark = syslog_lock.synchronize { syslog.size }
    open_page(udid, page_url)
    tapped = tap(xctestrun, udid, bundle_id, link.label, File.join(out_dir, "tap-#{results.size}.log"), extra)

    observation = nil
    deadline = Time.now + options[:wait]
    loop do
      observation = Observation.new(link, syslog_lock.synchronize { syslog[mark..] })
      break if observation.done? || Time.now > deadline

      sleep 1
    end
    results << [name, tapped, observation]
    delivery = observation.delivery.map { |l| l[/link delivery path=.*/] }
    delivery.each { |l| say "  #{l}" }
    say "  #{observation.pass? ? 'ok' : "missing #{observation.missing.join(', ')}#{tapped ? '' : ' (the tap itself failed)'}"}"
  end
end

puts
puts "Results (device #{udid}, #{bundle_id}, page #{page_url})"
puts '-' * 72
results.each do |name, _tapped, observation|
  paths = observation.delivery.map { |l| l[/path=(\S+)/, 1] }.uniq.join(', ')
  puts format('%-8s %-40s %s', observation.pass? ? 'Passed' : 'Failed', name, observation.pass? ? paths : "missing #{observation.missing.join(', ')}")
end
puts '-' * 72
say "logs: #{out_dir}"
File.write(File.join(out_dir, 'results.json'), JSON.pretty_generate(
  device: udid, bundle_id: bundle_id, page: page_url,
  taps: results.map { |name, tapped, o| { name: name, tapped: tapped, passed: o.pass?, missing: o.missing, delivery: o.delivery } }
))
exit(results.all? { |_, _, o| o.pass? } ? 0 : 1)
